# Required: a free Gemini API key from https://aistudio.google.com/apikey
# This is the key behind the "Aman's demo key" option on the page.
GEMINI_API_KEY=

# Optional: how many demo reviews one visitor can run per day on your key (default 3).
# Set to 0 to switch the demo off and make everyone bring their own key.
DEMO_LIMIT=3

# Optional: which Gemini model to use (default gemini-3.8-flash, which is on the free tier)
GEMINI_MODEL=

# Optional: a password for your own unlimited use. When set, entering it on the page
# skips the demo limit. Visitors without it still get the demo allowance.
ACCESS_CODE=
